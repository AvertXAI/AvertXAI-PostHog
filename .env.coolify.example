# =============================================================================
# .env.coolify.example — environment for docker-compose.coolify.yml
# =============================================================================
# Copy these into Coolify's "Environment Variables" UI for the resource (or a
# .env next to the compose file). DO NOT commit real secrets. Values shown are
# EXAMPLES / safe defaults — the two marked REQUIRED have no default and the
# stack will refuse to start without them.
#
# Generate the two secrets like bin/deploy-hobby does:
#   POSTHOG_SECRET_KEY:            head -c 28 /dev/urandom | sha224sum -b | head -c 56
#   POSTHOG_ENCRYPTION_SALT_KEYS:  openssl rand -hex 16   (must be exactly 16 bytes hex)
# Set them ONCE and never change them on a live instance — rotating SECRET_KEY
# logs everyone out; rotating ENCRYPTION_SALT_KEYS makes existing encrypted data
# (e.g. integration credentials) unreadable.
# =============================================================================

# --- Public address / TLS (Traefik) -----------------------------------------
# Hostname Traefik routes to this stack. Used in every Traefik Host(...) rule.
DOMAIN=e.avertxai.com
# Full public origin. Used for SITE_URL, object-storage public URLs, livestream,
# and Temporal UI CORS. Must be https:// (Traefik terminates TLS).
SITE_URL=https://e.avertxai.com
# Name of the HTTPS entrypoint defined in YOUR Traefik. Vanilla Traefik calls it
# "websecure"; Coolify's bundled Traefik usually calls it "https". CONFIRM and set.
TRAEFIK_ENTRYPOINT=websecure
# Name of the ACME/Let's Encrypt cert resolver defined in your Traefik static config.
TRAEFIK_CERTRESOLVER=letsencrypt

# --- Core secrets (REQUIRED — no defaults) -----------------------------------
POSTHOG_SECRET_KEY=change-me-56-char-django-secret
POSTHOG_ENCRYPTION_SALT_KEYS=change-me-32-hex-chars-0000000000

# --- Postgres ----------------------------------------------------------------
# These are interpolated into EVERY postgres:// connection string in the compose,
# so changing them is safe and consistent. On first boot the init scripts create
# the auxiliary databases (cyclotron, posthog_persons, behavioral_cohorts,
# flags_read_store, cyclotron_node, ...) owned by POSTGRES_USER.
POSTGRES_USER=posthog
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=posthog

# --- ClickHouse --------------------------------------------------------------
# NOTE: these are listed for completeness but are NOT currently wired into the
# compose. ClickHouse auth in this stack is governed by the mounted
# docker/clickhouse/users.xml (CLICKHOUSE_SKIP_USER_SETUP=1), and the node/rust
# consumers connect as the default user. To actually change ClickHouse
# credentials you must edit docker/clickhouse/users.xml AND add matching
# CLICKHOUSE_USER/CLICKHOUSE_PASSWORD env to the consuming services. Left here so
# the intent is explicit for a future hardening pass.
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# --- Object storage (MinIO root creds; app + MinIO must match) ---------------
OBJECT_STORAGE_ACCESS_KEY_ID=object_storage_root_user
OBJECT_STORAGE_SECRET_ACCESS_KEY=change-me-strong-minio-password

# --- Session replay v2 (SeaweedFS S3) ----------------------------------------
# SeaweedFS runs without S3 auth in this stack, so these are placeholders, not
# real secrets. Leave as "any" unless you put real auth in front of SeaweedFS.
SESSION_RECORDING_S3_ACCESS_KEY_ID=any
SESSION_RECORDING_S3_SECRET_ACCESS_KEY=any

# --- Telemetry ---------------------------------------------------------------
# Set to "true" to stop this instance from sending anonymous usage to PostHog.
OPT_OUT_CAPTURE=false

# --- Image tags --------------------------------------------------------------
# Container registry/org for the PostHog app + node images. Default pulls the
# public Docker Hub images.
POSTHOG_REGISTRY=posthog/posthog
# IMPORTANT: PostHog publishes only MOVING tags for these (latest / master).
# PIN to a specific commit SHA before production so deploys are reproducible.
#   posthog/posthog       -> POSTHOG_IMAGE_TAG   (web, worker, temporal worker, migrations)
#   posthog/posthog-node  -> POSTHOG_NODE_TAG    (plugins, ingestion-*, recording-api)
#   ghcr.io/posthog/posthog/<bin> -> POSTHOG_RUST_TAG (capture, flags, personhog, cymbal, ...)
POSTHOG_IMAGE_TAG=latest
POSTHOG_NODE_TAG=latest
POSTHOG_RUST_TAG=master
